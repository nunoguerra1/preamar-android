<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cream_textured"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho escuro com a lua do dia da saída -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_detalhe_atividade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sand_coral"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="MERGULHO" />

                <TextView
                    android:id="@+id/tv_detalhe_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Preamar.Display"
                    android:textSize="28sp"
                    tools:text="Praia do Gonzaga" />

                <TextView
                    android:id="@+id/tv_detalhe_quando"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/cream_dim"
                    android:textSize="14sp"
                    tools:text="24/10/2026 · 14:30" />
            </LinearLayout>

            <com.nunoguerra.preamar.ui.widget.MoonPhaseView
                android:id="@+id/moon_detalhe"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/cd_moon_phase" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Preamar.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detalhe_condicoes"
                    android:textAppearance="@style/TextAppearance.Preamar.CardTitle" />

                <TextView
                    android:id="@+id/tv_detalhe_condicoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="6dp"
                    android:textAppearance="@style/TextAppearance.Preamar.Body"
                    tools:text="Fase da lua: Lua cheia\nIluminação: 100%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Preamar.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nova_saida_obs"
                    android:textAppearance="@style/TextAppearance.Preamar.CardTitle" />

                <TextView
                    android:id="@+id/tv_detalhe_obs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Preamar.Body"
                    tools:text="Visibilidade ótima, vi uma tartaruga." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_excluir"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/detalhe_excluir"
            android:textColor="@color/danger"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_delete"
            app:iconTint="@null"
            app:strokeColor="@color/danger" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
