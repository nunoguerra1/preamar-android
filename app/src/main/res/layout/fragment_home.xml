<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cream_textured"
    tools:context=".ui.home.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:collapsedTitleGravity="start|center_vertical"
            app:collapsedTitleTextAppearance="@style/TextAppearance.Preamar.CollapsedTitle"
            app:collapsedTitleTextColor="@color/cream"
            app:contentScrim="@color/ocean_deeper"
            app:expandedTitleGravity="bottom|start"
            app:expandedTitleMarginBottom="74dp"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextAppearance="@style/TextAppearance.Preamar.ExpandedTitle"
            app:expandedTitleTextColor="@color/cream"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="250"
            app:statusBarScrim="@color/ocean_deeper"
            app:title="@string/home_title"
            app:toolbarId="@+id/toolbar">

            <!-- Fundo do cabeçalho com cantos inferiores arredondados -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_header_rounded" />

            <!-- Tartaruga pontilhada com parallax -->
            <ImageView
                android:id="@+id/dotted_turtle"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="-28dp"
                android:alpha="0.9"
                android:contentDescription="@string/cd_dotted_turtle"
                android:src="@drawable/ic_turtle_dotted"
                android:tint="@color/sand_coral"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.55" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="32dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/cream_dim"
                android:textSize="13sp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.8" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="110dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/home_atividade_label"
                android:textAppearance="@style/TextAppearance.Preamar.Caption" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
        android:paddingEnd="20dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_atividade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_mergulho"
                        style="@style/Widget.Preamar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mergulho" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tide_pooling"
                        style="@style/Widget.Preamar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tide pooling" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pesca"
                        style="@style/Widget.Preamar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pesca sustentável" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_observacao"
                        style="@style/Widget.Preamar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Observação" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Card: melhores janelas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_janelas"
                style="@style/Widget.Preamar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_badge_circle"
                            android:backgroundTint="@color/teal_accent"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:src="@drawable/ic_badge_wave" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/home_card_janelas_title"
                            android:textAppearance="@style/TextAppearance.Preamar.CardTitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_janela_principal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="@style/TextAppearance.Preamar.Big"
                        tools:text="Hoje · 14:00–15:30" />

                    <TextView
                        android:id="@+id/tv_janela_detalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Preamar.Body"
                        tools:text="Nota 87/100 · Maré baixa · Sizígia" />

                    <TextView
                        android:id="@+id/tv_outras_janelas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:textAppearance="@style/TextAppearance.Preamar.Caption"
                        tools:text="Amanhã · 06:30–08:00 (nota 82)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: gráfico de maré -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mare"
                style="@style/Widget.Preamar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_badge_circle"
                            android:backgroundTint="@color/ocean_deep"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:src="@drawable/ic_badge_wave" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/home_card_mare_title"
                            android:textAppearance="@style/TextAppearance.Preamar.CardTitle" />
                    </LinearLayout>

                    <com.nunoguerra.preamar.ui.widget.TideChartView
                        android:id="@+id/tide_chart"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/cd_tide_chart" />

                    <TextView
                        android:id="@+id/tv_mare_agora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Preamar.Body"
                        tools:text="Agora: Maré enchendo · Sizígia" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: lua -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_lua"
                style="@style/Widget.Preamar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.nunoguerra.preamar.ui.widget.MoonPhaseView
                        android:id="@+id/moon_view"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/cd_moon_phase" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_card_lua_title"
                            android:textAppearance="@style/TextAppearance.Preamar.Caption" />

                        <TextView
                            android:id="@+id/tv_lua_fase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Preamar.Big"
                            tools:text="Gibosa crescente" />

                        <TextView
                            android:id="@+id/tv_lua_detalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Preamar.Body"
                            tools:text="94% iluminada · 12,5 dias de idade" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: última saída -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ultima"
                style="@style/Widget.Preamar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_badge_circle"
                        android:backgroundTint="@color/sand_coral"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_badge_pin" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_card_last_trip_title"
                            android:textAppearance="@style/TextAppearance.Preamar.CardTitle" />

                        <TextView
                            android:id="@+id/tv_ultima_titulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_card_last_trip_empty"
                            android:textAppearance="@style/TextAppearance.Preamar.Body" />

                        <TextView
                            android:id="@+id/tv_ultima_detalhe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Preamar.Caption"
                            android:visibility="gone"
                            tools:text="Lua cheia · Sizígia · Maré alta" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
                android:layout_marginTop="18dp"
                android:text="@string/home_disclaimer"
                android:textAppearance="@style/TextAppearance.Preamar.Caption"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_trip"
        style="@style/Widget.Preamar.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:layout_marginBottom="92dp"
        android:contentDescription="@string/home_fab_new_trip"
        android:src="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
